model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - LH_BRONZE_LAYER"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb"]

ref table dbo_Customer
ref table dbo_Product
ref table dbo_Sales
ref table dbo_Store
ref table sales
ref table sys_dq_metrics

